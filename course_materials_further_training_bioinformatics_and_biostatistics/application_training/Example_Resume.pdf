:"TechnologyItem"},{"description":"","showTitle":true,"tags":["In vitro infection","Virus cultivation","Virus isolation","Plaque assay"],"title":"Virology","height":120,"id":"lopqkwh6","record":"TechnologyItem"},{"description":"","showTitle":true,"tags":["Confocal Laser Scanning Microscopy","Light Microscopy","Fluorescence Microscopy","Electron Microscopy"],"title":"Microscopy","height":197,"id":"lopqn240","record":"TechnologyItem"}],"name":"EXPERIMENTAL SKILLS"},{"__t":"AdditionalTechnologySection","surroundingBorder":false,"record":"AdditionalTechnologySection","column":1,"enabled":true,"height":38,"items":[{"description":"","showTitle":true,"tags":["MS Office","GraphPad Prism","RStudio","ImageJ","Benching","CLC Genomics"],"title":"Data analysis and visualization","height":159,"id":"3uyqucj37x","record":"TechnologyItem"},{"description":"","showTitle":true,"tags":["R (Intermediate)","Bash (Intermediate)","Python (Beginner)","ImageJ Macro Language (Beginner)"],"title":"Programming","height":197,"id":"lopqpsn6","record":"TechnologyItem"}],"name":"TECHNICAL SKILLS"},{"__t":"AdditionalExperienceSection","timelineWidth":136,"record":"AdditionalExperienceSection","column":1,"enabled":true,"height":38,"items":[{"dateRange":{"record":"DateRange","fromMonth":null,"fromYear":2021,"isOngoing":false,"ongoingText":"","toMonth":null,"toYear":null},"table":{"record":"TableItem","cols":2,"rows":[["&lt;b&gt;Project name&lt;/b&gt;","&lt;b&gt;Description&lt;/b&gt;"],["",""]]},"bullets":["Digital Cooperation and Intercultural Competence","Team Building and Interdisciplinary Collaboration","Winter School at the Arizona State University learning about Inclusive Teaching Strategies"],"description":"","link":"","location":"","position":"MÃ¼nster-Arizona Virtual Academic Collaboration","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":false,"showTable":true,"showTitle":true,"workplace":"MÃ¼nster University","height":215,"id":"gcv52l7qu7","record":"ExperienceItem"}],"name":""},{"__t":"PublicationSection","record":"PublicationSection","column":0,"enabled":true,"height":38,"items":[{"dateRange":{"record":"DateRange","fromMonth":null,"fromYear":2022,"isOngoing":false,"ongoingText":"","toMonth":null,"toYear":null},"author":"Jennifer Musterfrau, Paul Dobrin, Linus Berger","description":"&lt;div&gt;This study introduces a novel biosensor technique designed for precise measurement of autoinducer-2 (AI-2), facilitating both qualitative and quantitative analyses essential for exploring AI-2 mediated quorum sensing mechanisms in bacterial populations.&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;","edition":"ACS Synthetic Biology","link":"https://doi.org/10.1021/acssynbio.1c00459","showAuthor":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":true,"title":"A novel biosensor approach for precise autoinducer-2 measurement.","height":205,"id":"7ogsljydqd","record":"PublicationItem"},{"dateRange":{"record":"DateRange","fromMonth":null,"fromYear":2021,"isOngoing":false,"ongoingText":"","toMonth":null,"toYear":null},"author":"Alexander Rehm, Nadine Wallenstein, Stefan Kalp, Giuseppe Homburg, Hanna Magistro, Emmanuelle Chagneau, Jean-Philippe Klimek, SÃ¶ren Revelles, Ulrich Helloin, Eric Putze, Johannes NougayrÃ¨de, Jennifer Musterfrau, Olga Oswald, Camille V. Dobrindt.","description":"Investigation of the regulatory role of the RNA-binding protein CsrA on colibactin and yersiniabactin expression, two fitness determinants in extraintestinal colonizing &lt;i&gt;E. coli&lt;/i&gt; isolates.","edition":"mBio - ASM Journals","link":"https://doi.org/10.1128/mbio.05834-31","showAuthor":true,"showCompany":true,"showDateRange":true,"showDescription":true,"showLink":true,"title":"Interlinked pathways of polyketide synthesis: posttranscriptional regulation by CsrA impacting colibactin and yersiniabactin production in Escherichia coli","height":259,"id":"lopscyce","record":"PublicationItem"}],"name":""},{"__t":"TalentSection","showIcons":true,"record":"TalentSection","column":1,"enabled":true,"height":38,"items":[{"description":"In order to make a change we all have to take responsibility. My time as a Ph.D. student has taught me to take responsibility, not only for my project but also for undergraduates that I was allowed to supervise.","icon":"handshake","showDescription":true,"title":"Responsibility","height":142,"id":"lopudyr4","record":"TalentItem"},{"description":"In a rapid changing world, the eagerness to constantly learn and acquire new skills is a trait that I have incorporated throughout my whole life.","icon":"94-marketing-01","showDescription":true,"title":"Eagerness","height":109,"id":"loprsqzf","record":"TalentItem"},{"description":"Science is amazing and there is so much more left to discover - I am very enthusiastic to be able to add new knowledge into this fascinating world.","icon":"132-smile","showDescription":true,"title":"Enthusiasm","height":109,"id":"lopuf3qt","record":"TalentItem"}],"name":""}],"user":"65a79c7779c3705687f9ca9a"}</pdfx:ecv-data>
