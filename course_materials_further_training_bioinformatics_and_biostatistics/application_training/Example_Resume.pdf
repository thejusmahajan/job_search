         <pdfx:ecv-data>{"_id":"6633b4e9e4b8b92971094cdc","style":{"layoutSize":"medium","background":null,"colors":["#000000","#1E90FF"],"fontBody":"interui","fontHeading":"rubik","fontSize":2,"isMetaDataDisabled":true,"layout":"double","marginOption":2,"pageMarginOption":4,"record":"ResumeStyle"},"header":{"record":"Header","email":"jen.musterfrau@web.de","extraField":"","extraLink":"","height":153,"link":"https://www.linkedin.com/","location":"Vreden","name":"JENNIFER MUSTERFRAU","phone":"+49 157 1234567","photo":"https://enhancv.s3.amazonaws.com/avatars/22230d415d54e7ba8b764be7ee9328c5bb04bae3293b561a32be59cc3731a57b.jpg","photoStyle":"round","showEmail":true,"showExtraField":false,"showExtraLink":false,"showLink":true,"showLocation":true,"showPhone":true,"showPhoto":true,"showTitle":true,"title":"Ph.D. student","uppercaseName":true},"sections":[{"__t":"SummarySection","showTitle":true,"record":"SummarySection","column":0,"enabled":true,"height":38,"items":[{"alignment":"left","text":"I am a passionate biologist with expertise in molecular biology and microbiology. During my studies I have gained a lot of knowledge about bacterial behavior and communication in the context of extraintestinal colonization. The time as a Ph.D. student has taught me to concisely present research results in front of a broad audience coming from different fields, and how to  organize a project, also within a team. To complement my wet lab expertise, I am currently engaging a further training in bioinformatics and biostatistics, seeking an internship where I can bring my knowledge into account and profit from the knowledge and competence of several collaborators of different backgrounds but with the same mission â€“ to responsibly feed the world and protect the planet.","height":210,"id":"fytshsr016","record":"SummaryItem"}],"name":""},{"__t":"ExperienceSection","timelineWidth":136,"record":"ExperienceSection","column":0,"enabled":true,"height":38,"items":[{"dateRange":{"record":"DateRange","fromMonth":10,"fromYear":2023,"isOngoing":true,"ongoingText":"","toMonth":null,"toYear":null},"table":{"record":"TableItem","cols":2,"rows":[["&lt;b&gt;Project name&lt;/b&gt;","&lt;b&gt;Description&lt;/b&gt;"],["",""]]},"bullets":["Introduction to programming and Python (including Shell (BASH), programming methodology, object-oriented programming in Python)","Bioinformatics and databases (including NCBI, Biopython, web services and database management, SQL)","Applied bioinformatics (including sequence analysis and strategies, structural bioinformatics, software for structure visualization, NGS analysis using Galaxy)","Applied biostatistics (including statistical analysis using R, descriptive and multivariate statistics, ANOVA, PCA, HCA, workflows using R/Bioconductor, Markov chain implementation)"],"description":"","link":"","location":"Berlin","position":"Further Training - Application-related Bioinformatics and Biostatistics","showBullets":true,"showCompany":true,"showDateRange":true,"showDescription":false,"showLink":false,"showLocation":true,"showTable":true,"showTitle":true,"workplace":"CQ Beratung + Bildung GmbH","height":263,"id":"wlhvr0e2oj","record":"ExperienceItem"}],"name":"CURRENT OCCUPATION"},{"__t":"EducationSection","timelineWidth":136,"record":"EducationSection","column":0,"enabled":true,"height":38,"items":[{"dateRange":{"record":"DateRange","fromMonth":3,"fromYear":2020,"isOngoing":false,"ongoingText":"","toMonth":11,"toYear":2023},"bullets":["Thesis: Exploring the impact of multifunctional regulatory networks on the evolution and adaptation of pathogenic and commensal Escherichia coli strains.","DFG-funded research training group \"Evolutionary Processes in Adaptation and Disease\"","Working with clinical &lt;i&gt;Escherichia coli &lt;/i&gt;isolates"],"degree":"Ph.D. in Biology","gpa":"","gpaText":"","institution":"MÃ¼nster University, Institute of Hygiene","location":"University Hospital Aachen","maxGpa":"","showBullets":true,"showDateRange":true,"showGpa":false,"showLocation":true,"height":179,"id":"r5lnqzdjgb","record":"EducationItem"},{"dateRange":{"record":"DateRange","fromMonth":9,"fromYear":2017,"isOngoing":false,"ongoingText":"","toMonth":8,"toYear":2019},"bullets":["Final grade: 1.2","Thesis: Production of recombinant virus and mechanisms of viral infection(Grade: 1.0)","In collaboration with Abalos Therapeutics GmbH","Working with the &lt;i&gt;lymphocytic choriomeningitis virus &lt;/i&gt;(LCMV)"],"degree":"M.Sc. in Medical Biology","gpa":"","gpaText":"","institution":"Duisburg-Essen University, Institute of Immunology","location":"University Hospital MÃ¼nster","maxGpa":"","showBullets":true,"showDateRange":true,"showGpa":false,"showLocation":true,"height":162,"id":"pnotj0tvsf","record":"EducationItem"},{"dateRange":{"record":"DateRange","fromMonth":9,"fromYear":2013,"isOngoing":false,"ongoingText":"","toMonth":8,"toYear":2017},"bullets":["Final grade: 1.8","Thesis: Redox-dependent interaction of Cyclophilin 20-3 and 2-Cysteine Peroxiredoxin in vivo (Grade: 1.3)","Working with &lt;i&gt;Arabidopsis thaliana&lt;/i&gt;"],"degree":"B.Sc. in Molecular Biology","gpa":"","gpaText":"","institution":"Bielefeld University, Institute of Biochemistry and Physiology of Plants","location":"Bielefeld University","maxGpa":"","showBullets":true,"showDateRange":true,"showGpa":false,"showLocation":true,"height":164,"id":"xuj6z21oqs","record":"EducationItem"},{"dateRange":{"record":"DateRange","fromMonth":7,"fromYear":2005,"isOngoing":false,"ongoingText":"","toMonth":5,"toYear":2013},"bullets":["Final grade: 2.4","Advanced courses: Math, English","Basic courses: Biology, Geography"],"degree":"General qualification for university entrance","gpa":"","gpaText":"","institution":"Gymnasium Georgianium Vreden","location":"Vreden","maxGpa":"","showBullets":true,"showDateRange":true,"showGpa":false,"showLocation":true,"height":130,"id":"lopq61kn","record":"EducationItem"}],"name":""},{"__t":"VolunteerSection","record":"